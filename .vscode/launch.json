{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run YatraSathi",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": { "FLASK_DEBUG": "1" },
      "justMyCode": true
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    }
  ]
}
