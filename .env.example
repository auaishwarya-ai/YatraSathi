# Copy this file to ".env" and edit the values if needed.

# Secret key used to sign login sessions (change it for real deployments)
SECRET_KEY=change-me-to-a-long-random-string

# OPTIONAL - OpenAI API key. When set, informational chat answers are written by
# the LLM using the RAG passages (grounded). Leave empty to use the built-in
# offline AI (works without internet or API keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Create demo users, trips, chats and feedback on first run (1 = yes, 0 = no)
LOAD_DEMO_DATA=1
